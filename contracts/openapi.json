{
  "components": {
    "schemas": {
      "ApiErrorResponse": {
        "properties": {
          "code": {
            "description": "Stable snake_case application error code.",
            "type": "string"
          },
          "details": {
            "description": "Optional structured error details.",
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "type": "object"
      },
      "ApplicableAudience": {
        "enum": [
          "all_students",
          "new_students",
          "undergraduate",
          "graduate",
          "organization_members"
        ],
        "type": "string"
      },
      "ArchiveCategory": {
        "enum": [
          "onboarding",
          "campus_life",
          "academics",
          "organizations",
          "procedures",
          "other"
        ],
        "type": "string"
      },
      "CapabilityFlags": {
        "properties": {
          "aiArchiveEnabled": {
            "type": "boolean"
          },
          "attachmentsEnabled": {
            "type": "boolean"
          },
          "authMockEnabled": {
            "type": "boolean"
          },
          "desktopEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "authMockEnabled",
          "desktopEnabled",
          "aiArchiveEnabled",
          "attachmentsEnabled"
        ],
        "type": "object"
      },
      "ChangeStatusRequest": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ModerationStatus"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Correction": {
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "postId": {
            "type": "string"
          },
          "reporterId": {
            "type": "string"
          },
          "resolvedAt": {
            "type": "string"
          },
          "resolvedBy": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "postId",
          "reporterId",
          "message",
          "createdAt"
        ],
        "type": "object"
      },
      "CorrectionCollection": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Correction"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "CreateKnowledgeEntryRequest": {
        "properties": {
          "applicableAudience": {
            "$ref": "#/components/schemas/ApplicableAudience"
          },
          "body": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/ArchiveCategory"
          },
          "sourceKind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "sourceReference": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "body",
          "category",
          "applicableAudience",
          "sourceKind"
        ],
        "type": "object"
      },
      "CurrentUser": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "organizations": {
            "items": {
              "$ref": "#/components/schemas/OrganizationMembership"
            },
            "type": "array"
          },
          "systemRole": {
            "enum": [
              "student",
              "organization_member",
              "moderator",
              "admin"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName",
          "systemRole",
          "organizations"
        ],
        "type": "object"
      },
      "FileCorrectionRequest": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "KnowledgeEntry": {
        "properties": {
          "applicableAudience": {
            "$ref": "#/components/schemas/ApplicableAudience"
          },
          "authorId": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/ArchiveCategory"
          },
          "createdAt": {
            "type": "string"
          },
          "currentRevision": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "moderationStatus": {
            "$ref": "#/components/schemas/ModerationStatus"
          },
          "sourceKind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "sourceReference": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "authorId",
          "title",
          "body",
          "tags",
          "category",
          "applicableAudience",
          "sourceKind",
          "moderationStatus",
          "currentRevision",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "LoginResponse": {
        "properties": {
          "expiresAt": {
            "description": "UTC ISO 8601 session expiry.",
            "type": "string"
          },
          "token": {
            "description": "Opaque session token, returned exactly once.",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/CurrentUser"
          }
        },
        "required": [
          "token",
          "expiresAt",
          "user"
        ],
        "type": "object"
      },
      "MetaResponse": {
        "properties": {
          "appName": {
            "const": "Campus Agora",
            "type": "string"
          },
          "capabilities": {
            "$ref": "#/components/schemas/CapabilityFlags"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "appName",
          "version",
          "capabilities"
        ],
        "type": "object"
      },
      "MockLoginRequest": {
        "properties": {
          "persona": {
            "description": "Deterministic mock campus persona.",
            "enum": [
              "student",
              "organization_member",
              "moderator",
              "admin"
            ],
            "type": "string"
          }
        },
        "required": [
          "persona"
        ],
        "type": "object"
      },
      "ModerationStatus": {
        "enum": [
          "draft",
          "published",
          "hidden",
          "rejected"
        ],
        "type": "string"
      },
      "OrganizationMembership": {
        "properties": {
          "name": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "organizationId",
          "slug",
          "name"
        ],
        "type": "object"
      },
      "PaginatedKnowledgeEntries": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeEntry"
            },
            "type": "array"
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "totalItems": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ],
        "type": "object"
      },
      "ReadinessChecks": {
        "properties": {
          "postgres": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "type": "string"
          }
        },
        "required": [
          "postgres"
        ],
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "enum": [
              "ready",
              "unready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "Revision": {
        "properties": {
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "editorId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "revision",
          "editorId",
          "title",
          "body",
          "tags",
          "createdAt"
        ],
        "type": "object"
      },
      "RevisionCollection": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Revision"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "expiresAt": {
            "description": "UTC ISO 8601 session expiry.",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/CurrentUser"
          }
        },
        "required": [
          "user",
          "expiresAt"
        ],
        "type": "object"
      },
      "SourceKind": {
        "enum": [
          "firsthand_experience",
          "official_announcement",
          "group_chat",
          "discussion",
          "unspecified"
        ],
        "type": "string"
      },
      "UpdateKnowledgeEntryRequest": {
        "description": "Every field is optional; omitted fields keep their stored value.",
        "properties": {
          "applicableAudience": {
            "$ref": "#/components/schemas/ApplicableAudience"
          },
          "body": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/ArchiveCategory"
          },
          "sourceKind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "sourceReference": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "Opaque session token issued by mock-login.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Campus Agora API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session revoked"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Missing, invalid, expired, or revoked session token"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Revoke the current session"
      }
    },
    "/api/v1/auth/mock-login": {
      "post": {
        "description": "Available only while the authMockEnabled capability flag is on.",
        "operationId": "mockLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MockLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Session created for the mock persona"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Malformed request body"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Mock login is disabled"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unknown persona"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "security": [],
        "summary": "Mock campus login for development, CI, and demos"
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getAuthSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "The active session and its user"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Missing, invalid, expired, or revoked session token"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Current authenticated session"
      }
    },
    "/api/v1/knowledge-entries": {
      "get": {
        "description": "Guests see published entries. An authenticated caller also sees entries they authored or maintain; moderators and admins see all.",
        "operationId": "listKnowledgeEntries",
        "parameters": [
          {
            "description": "Case-insensitive match over title and summary.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ArchiveCategory"
            }
          },
          {
            "description": "1-based page number.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Defaults to 20, maximum 100.",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedKnowledgeEntries"
                }
              }
            },
            "description": "A page of knowledge entries"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Malformed query parameters"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Invalid or expired session token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Page or pageSize out of range"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "security": [],
        "summary": "List visible knowledge entries"
      },
      "post": {
        "operationId": "createKnowledgeEntry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateKnowledgeEntryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeEntry"
                }
              }
            },
            "description": "The knowledge entry"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Malformed body or unknown enum value"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Authentication required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Not allowed to create entries"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Field validation failed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a knowledge entry draft"
      }
    },
    "/api/v1/knowledge-entries/{id}": {
      "get": {
        "description": "An entry the caller may not see returns 404 rather than 403, so a private draft does not leak its existence.",
        "operationId": "getKnowledgeEntry",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeEntry"
                }
              }
            },
            "description": "The knowledge entry"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Entry id is not a UUID"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Invalid or expired session token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Entry missing or not visible to the caller"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "security": [],
        "summary": "Read one knowledge entry"
      },
      "parameters": [
        {
          "description": "Knowledge entry id (UUID).",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "description": "Editing a published entry writes a new revision and bumps currentRevision. Editing a draft updates in place.",
        "operationId": "updateKnowledgeEntry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateKnowledgeEntryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeEntry"
                }
              }
            },
            "description": "The knowledge entry"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Malformed body, unknown enum value, or bad id"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Authentication required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Not allowed to edit this entry"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Entry missing or not visible to the caller"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Field validation failed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Update a knowledge entry"
      }
    },
    "/api/v1/knowledge-entries/{id}/corrections": {
      "get": {
        "operationId": "listKnowledgeEntryCorrections",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorrectionCollection"
                }
              }
            },
            "description": "Corrections ordered oldest first"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Entry id is not a UUID"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Invalid or expired session token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Entry missing or not visible to the caller"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
