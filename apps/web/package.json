{
  "name": "@campus-agora/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src",
    "lint:styles": "biome check src/styles",
    "test": "bun test tests && bun run typecheck"
  },
  "dependencies": {
    "@campus-agora/api-client": "workspace:*",
    "@vitejs/plugin-react": "^4.3.1",
    "lucide-react": "^1.27.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.1",
    "typescript": "^5.4.5",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "happy-dom": "^20.11.1"
  }
}
