# Copy to .env (gitignored) and fill in locally. Never commit real keys.

# Zhipu BigModel (GLM-4.7-Flash free tier)
ZHIPU_API_KEY=

# Baidu Qianfan web_search (domestic search)
QIANFAN_API_KEY=

# Tavily (overseas search, free 1,000 credits/month, no card)
TAVILY_API_KEY=

# Jina Reader (optional; keyless works at a lower rate limit)
JINA_API_KEY=

# Optional: swap the extraction model by config (any OpenAI-compatible endpoint).
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.7-flash
# LLM_API_KEY=
